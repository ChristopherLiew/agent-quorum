{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "${PLUGIN_ROOT}/scripts/codex-session-start.sh", "timeout": 60 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "${PLUGIN_ROOT}/scripts/agent-quorum.sh", "args": ["hook", "--agent", "codex"] }] }],
    "PreToolUse": [
      { "matcher": "^(Bash|apply_patch)$", "hooks": [{ "type": "command", "command": "${PLUGIN_ROOT}/scripts/agent-quorum.sh", "args": ["hook", "--agent", "codex"], "timeout": 5 }] }
    ],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "${PLUGIN_ROOT}/scripts/agent-quorum.sh", "args": ["hook", "--agent", "codex"], "timeout": 5 }] }]
  }
}
